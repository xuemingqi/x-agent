# Copy to private .env and select it in each IDEA run configuration's Environment variables field.
# All six services can load the same file; no startup script is required.
# For manual java/Nacos commands instead: set -a; source .env; set +a
# Keep .env private. Nacos templates resolve these in each JVM process.
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=x-agent-dev
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=
NACOS_PASSWORD=

# Each service reads its own port from this same file. Do not set a shared SERVER_PORT.
X_AGENT_GATEWAY_PORT=18081
X_AGENT_AUTH_PORT=18082
X_AGENT_CONTACT_PORT=18084
X_AGENT_AI_PORT=18086
X_AGENT_MCP_RUNTIME_PORT=18087
X_AGENT_MCP_GATEWAY_PORT=18088
SPRING_CLOUD_NACOS_DISCOVERY_IP=127.0.0.1
# Keep local instances from executing scheduled jobs in a shared database.
# Enable explicitly when testing schedules or deploying a dedicated scheduler.
SPRING_QUARTZ_AUTO_STARTUP=false
# Assign a different worker ID to each concurrently running instance (0..31).
ID_WORKER_ID=1

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=x_agent
MYSQL_USERNAME=
MYSQL_PASSWORD=
REDIS_ADDRESS=redis://127.0.0.1:6379
REDIS_PASSWORD=

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=x-agent

# Generate two different random secrets, e.g. openssl rand -hex 32 (twice).
X_AGENT_INTERNAL_SECRET=
X_AGENT_JWT_SECRET=

# When using gateway port 28081, change both URLs below and set the
# frontend .env.local VITE_GATEWAY_URL=http://127.0.0.1:28081 as well.
AGENT_HTTP_API_URL=http://127.0.0.1:18081/ai/open/chat/run
AGENT_MCP_SERVER_URL=http://127.0.0.1:18081/mcp
AGENT_SANDBOX_IMAGE=x-agent-sandbox:1.0.0
# Docker must be able to mount these paths; use absolute shared host paths when deployed.
AGENT_PUBLIC_KNOWLEDGE_DIRECTORY=.agentscope/public-knowledge
AGENT_USER_WORKSPACE_DIRECTORY=.agentscope/user-workspaces
